rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The one supreme account: immune to being demoted, banned, or removed
    // by any other admin, and always has full authority over admin docs.
    function isOwner() {
      return isSignedIn() && request.auth.token.email == 'sgyiath@gmail.com';
    }

    // Delegated access to a sensitive section (payments, systemControls --
    // see js/admin-shell.js's SENSITIVE_KEYS) -- the owner always has it;
    // a regular admin only has it if their own admins/{uid} doc explicitly
    // lists this section in allowedSections. Deliberately NOT the same
    // "missing allowedSections == full access" grandfather rule the client
    // uses for ordinary nav sections -- these touch real money or sitewide
    // availability, so access must always be a current, explicit grant.
    function isOwnerOrGranted(section) {
      return isOwner() || (
        isAdmin() &&
        // allowedSections can be absent (old admin, pre-dates this field),
        // an actual list, or -- from an old grantAdmin() default -- literally
        // null (present but not a list). .get(key, []) only substitutes the
        // default for an ABSENT key, so a stored null would otherwise reach
        // .hasAny() and error out; the explicit "is list" check treats both
        // "absent" and "present but null" the same way: no grant.
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('allowedSections', []) is list &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('allowedSections', []).hasAny([section])
      );
    }

    // The owner's own account, plus the two admins with a real emergency
    // relationship to the owner (see js/supreme-mode.js) -- a delegated
    // "admins"-granted admin-manager (see isOwnerOrGranted('admins') below)
    // can never create, edit the sections of, or revoke any of these three,
    // even though they otherwise look like perfectly ordinary admins in the
    // regular panel. Only the owner (or Supreme Mode, which is just the
    // owner's own account through a different UI) can ever touch them.
    function isUntouchableByDelegatedAdmins(email) {
      return email == 'sgyiath@gmail.com' || email == 'georgemagdy117@gmail.com' || email == 'mostafahalafawy937@gmail.com';
    }

    function isParticipant(chatData) {
      return isSignedIn() && request.auth.uid in chatData.participantIds;
    }

    // A suspended or banned user keeps read access but cannot create new
    // content (listings, requests, messages, reviews, reports).
    function isActiveUser() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    // Fields a normal user must never be able to set on themselves directly
    // (trust/role/moderation state — only admins or trusted server flows may change these).
    function userProtectedFields() {
      return ['status', 'suspendedUntil', 'ratingAverage', 'ratingCount', 'accountType', 'uid', 'createdAt', 'photoURL'];
    }

    // One-time bootstrap: only this exact account may grant itself admin.
    // Beyond the owner, a regular admin explicitly granted "admins" in their
    // own allowedSections (see isOwnerOrGranted('admins') / js/admin-shell.js
    // canManageAdmins) can also create a new admin, edit an existing one's
    // allowedSections, or revoke them -- but never for the owner's own
    // account or the two specially-trusted ones (isUntouchableByDelegatedAdmins
    // above), and never handing out a sensitive section (payments,
    // systemControls, or admins itself) to anyone -- only the owner grants
    // those. A plain admin with no "admins" grant can still only manage
    // their own admin-mode password / support opt-in, same as always.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner() ||
        (isSignedIn() && request.auth.uid == uid && request.auth.token.email == 'sgyiath@gmail.com') ||
        (
          isOwnerOrGranted('admins') && !isOwner() &&
          !isUntouchableByDelegatedAdmins(request.resource.data.email) &&
          !request.resource.data.get('allowedSections', []).hasAny(['payments', 'systemControls', 'admins', 'superAdmin'])
        );
      allow update: if isOwner() || (
        isAdmin() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminModeCode', 'acceptingSupport'])
      ) || (
        isOwnerOrGranted('admins') && !isOwner() &&
        !isUntouchableByDelegatedAdmins(resource.data.email) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedSections']) &&
        !resource.data.get('allowedSections', []).hasAny(['payments', 'systemControls', 'admins', 'superAdmin']) &&
        !request.resource.data.allowedSections.hasAny(['payments', 'systemControls', 'admins', 'superAdmin'])
      );
      allow delete: if (isOwner() && resource.data.email != 'sgyiath@gmail.com') ||
        (isOwnerOrGranted('admins') && !isOwner() && !isUntouchableByDelegatedAdmins(resource.data.email));
    }

    // adminModeCode used to live on admins/{uid} itself, but that doc's read
    // rule is isSignedIn() (needed for the public support-admin picker and
    // isAdmin() checks) -- meaning any regular user's client could read
    // every admin's plaintext unlock code directly from the network
    // response. Split into its own doc with much narrower read access:
    // only that admin themselves, or the owner.
    match /adminSecrets/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwner());
      allow create: if isSignedIn() &&
        ((request.auth.uid == uid && request.auth.token.email == 'sgyiath@gmail.com') || isAdmin());
      allow update: if isOwner() || (isAdmin() && request.auth.uid == uid);
      allow delete: if isOwner() || (isAdmin() && request.auth.uid == uid);
    }

    match /users/{uid} {
      // Full profile documents hold phone/email — never expose them broadly.
      // Only the owner of the doc or an admin may read it; every legitimate
      // read site in the app (own-profile subscription, Admin.listAllUsers())
      // already fits this. Anything else (product owner name, chat participant
      // name, etc.) is denormalized onto its own document, not live-read here.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isOwner() ||
        (
          // The only thing the app's own admin UI ever does to another
          // user's doc is suspend/ban/reactivate (Admin.setUserStatus) --
          // narrowed to exactly that, not "any field but photoURL", so a
          // compromised or rogue admin account can't rewrite someone's
          // phone/email/accountType/rating directly.
          isAdmin() && resource.data.email != 'sgyiath@gmail.com' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'suspendedUntil'])
        ) || (
        isSignedIn() && request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(userProtectedFields())
      ) || (
        // Client-driven phone-violation enforcement, with no backend/cron to
        // run it server-side: a user may only ever flip their OWN status in
        // exactly two narrow directions — self-suspend for <=25h as the 3rd-
        // strike penalty, or self-reactivate once that window has genuinely
        // passed (request.time is server-evaluated, so this can't be spoofed
        // early). A `banned` account can never touch its own status here.
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'suspendedUntil']) &&
        (
          (resource.data.status == 'active' && request.resource.data.status == 'suspended' &&
           request.resource.data.suspendedUntil is timestamp &&
           request.resource.data.suspendedUntil > request.time &&
           request.resource.data.suspendedUntil <= request.time + duration.value(25, 'h'))
          ||
          (resource.data.status == 'suspended' && resource.data.suspendedUntil != null &&
           request.time > resource.data.suspendedUntil &&
           request.resource.data.status == 'active' && request.resource.data.suspendedUntil == null)
        )
      );
      allow delete: if isOwner() ||
        (isAdmin() && resource.data.email != 'sgyiath@gmail.com');
    }

    // National ID number + encrypted ID card photo (key/IV live here too --
    // see js/firebase.js's Crypto/IdentityVerification). Deliberately NOT
    // fields on users/{uid} -- that doc's read rule lets ANY admin read it,
    // which is far broader than the owner wants for something this
    // sensitive. Only the user themselves, or an admin explicitly granted
    // "identity" in allowedSections (owner always has it), can read this.
    match /identityVerification/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwnerOrGranted('identity'));
      allow create, update: if (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.nationalId is string && request.resource.data.nationalId.size() == 14 &&
        request.resource.data.idCardPhotoUrl is string && request.resource.data.idCardPhotoUrl.size() > 0 &&
        request.resource.data.idCardPhotoKey is string && request.resource.data.idCardPhotoKey.size() > 0 &&
        request.resource.data.idCardPhotoIv is string && request.resource.data.idCardPhotoIv.size() > 0
      ) || (
        // Same field-shape requirement, just for an admin explicitly
        // granted "identity" correcting/entering it on a user's behalf
        // (js/pages/admin-users.js) -- the owner always has this grant.
        isOwnerOrGranted('identity') &&
        request.resource.data.nationalId is string && request.resource.data.nationalId.size() == 14 &&
        request.resource.data.idCardPhotoUrl is string && request.resource.data.idCardPhotoUrl.size() > 0 &&
        request.resource.data.idCardPhotoKey is string && request.resource.data.idCardPhotoKey.size() > 0 &&
        request.resource.data.idCardPhotoIv is string && request.resource.data.idCardPhotoIv.size() > 0
      );
      allow delete: if isOwner();
    }

    // Public, Instagram-style farmer profile -- deliberately a SEPARATE doc
    // from users/{uid} (which holds phone/email and is never publicly
    // readable). Only fullName/photoURL/governorate/crops/bio are ever
    // stored here; created once at registration for farmer accounts only
    // (see js/firebase.js's Profile.createUserProfile), kept in sync for
    // photoURL via Profile.updatePhotoURL, and self-healed for any farmer
    // who registered before this existed via a one-time backfill check in
    // js/dashboard-shell.js. bio is the one field the farmer can edit
    // directly, through js/pages/profile.js.
    match /sellerProfiles/{uid} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'photoURL', 'governorate', 'crops', 'bio', 'pickupPoint', 'updatedAt', 'createdAt']) &&
        request.resource.data.get('bio', '') is string && request.resource.data.get('bio', '').size() <= 500 &&
        (!('pickupPoint' in request.resource.data) ||
         (request.resource.data.pickupPoint.lat is number && request.resource.data.pickupPoint.lng is number));

      // Deliberately narrow -- an admin may manage a farmer's pickup point
      // (per the owner's ask) but never their name/photo/bio/crops through
      // this branch. Kept separate from the self-update branch above rather
      // than just adding isAdmin() there, so this stays auditable as its
      // own distinct grant.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pickupPoint']) &&
        request.resource.data.pickupPoint.lat is number && request.resource.data.pickupPoint.lng is number;
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      // paymentInfo holds the owner's own bank/wallet receiving details --
      // excluded from the public read here (unlike every other settings
      // doc) and given its own owner-only rule below.
      allow read: if docId != 'paymentInfo';
      // killSwitch, maintenanceMode, chatDisabled, and paymentInfo are all
      // excluded here and given their own owner-only rules below --
      // Firestore ORs every matching block together, so without this
      // exclusion a regular admin would still be able to write through
      // this generic rule regardless of the narrower ones.
      allow write: if isAdmin() &&
        docId != 'killSwitch' && docId != 'maintenanceMode' && docId != 'chatDisabled' && docId != 'paymentInfo';
    }

    // Emergency kill switch: owner-only, on purpose -- this is a
    // whole-site lock, not a normal admin setting. Read stays public
    // because every page (including logged-out visitors) must be able to
    // check it to know whether to render the lock screen.
    match /settings/killSwitch {
      allow read: if true;
      allow write: if isOwner();
    }

    // Softer "under maintenance" full-site screen, separate from the kill
    // switch above -- no unlock-via-login form, the owner just flips it
    // back off from the admin panel, which is why signed-in admins are
    // exempted client-side from ever seeing the overlay. Read stays public
    // for the same reason as killSwitch: every visitor's page needs to
    // check it. Write is delegatable to an admin explicitly granted
    // "systemControls" (see admin-admins.html), not owner-only forever.
    match /settings/maintenanceMode {
      allow read: if true;
      allow write: if isOwnerOrGranted('systemControls');
    }

    // Sitewide chat-disable switch (see the chats/messages create rule
    // below for the actual enforcement). Same delegation as maintenanceMode
    // above.
    match /settings/chatDisabled {
      allow read: if true;
      allow write: if isOwnerOrGranted('systemControls');
    }

    // The platform's own payment-receiving details (Vodafone Cash /
    // InstaPay / bank account) for the manual-payment flow -- there's no
    // live payment gateway in this project, so buyers are told where to
    // send money manually and the owner (or an admin explicitly granted
    // "payments") confirms receipt themselves. Read is open to any
    // signed-in user -- a buyer with an order awaiting payment needs to see
    // it to know where to actually send money, same as any storefront
    // publishing its own receiving details to a customer.
    match /settings/paymentInfo {
      allow read: if isSignedIn();
      allow write: if isOwnerOrGranted('payments');
    }

    // Real homepage stat counters (registered farmers, completed deals) --
    // bumped by ordinary signed-in users at the moment those events happen
    // (registration, offer acceptance), not just admins. Same narrow
    // "bump by exactly 1" shape already used for products' view/offer/deal
    // counters; the isAdmin() branch above still covers full admin access.
    match /settings/publicStats {
      allow read: if true;
      allow write: if isSignedIn() && (
        (resource == null &&
         request.resource.data.diff({}).affectedKeys().hasOnly(['registeredFarmers']) &&
         request.resource.data.registeredFarmers == 1)
        ||
        (resource != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredFarmers']) &&
         request.resource.data.registeredFarmers == resource.data.get('registeredFarmers', 0) + 1)
        ||
        (resource == null &&
         request.resource.data.diff({}).affectedKeys().hasOnly(['completedDeals']) &&
         request.resource.data.completedDeals == 1)
        ||
        (resource != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedDeals']) &&
         request.resource.data.completedDeals == resource.data.get('completedDeals', 0) + 1)
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if (
        isActiveUser() && request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.viewsCount == 0 &&
        request.resource.data.offersCount == 0 &&
        request.resource.data.dealsCount == 0
      ) || (
        // Admin creating a listing on behalf of a farmer who's having
        // trouble doing it themselves (js/pages/admin-listings.js) -- same
        // zero-initialized-counters requirement as the self-service branch,
        // just without the ownerId==caller restriction.
        isAdmin() &&
        request.resource.data.viewsCount == 0 &&
        request.resource.data.offersCount == 0 &&
        request.resource.data.dealsCount == 0
      );

      // Owner/admin may edit listing content but not directly rewrite the
      // trust/ranking counters (viewsCount, offersCount, dealsCount).
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.ownerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['viewsCount', 'offersCount', 'dealsCount', 'ownerId'])
      ) || (
        // Public view counter: anyone may bump it by exactly 1, nothing else.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']) &&
        request.resource.data.viewsCount == resource.data.viewsCount + 1
      ) || (
        // Deals counter: only a signed-in user may bump it by exactly 1.
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dealsCount']) &&
        request.resource.data.dealsCount == resource.data.dealsCount + 1
      ) || (
        // Offers counter: only a signed-in user may bump it by exactly 1.
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offersCount']) &&
        request.resource.data.offersCount == resource.data.offersCount + 1
      ) || (
        // Favorites/comments/shares counters -- cosmetic engagement numbers,
        // not financial or authorization-sensitive, so they get exactly the
        // same trust level as viewsCount above: any signed-in user may bump
        // by exactly 1 in either direction (favorites can be un-hearted),
        // no cross-document proof required.
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoritesCount']) &&
        (request.resource.data.favoritesCount == resource.data.get('favoritesCount', 0) + 1 ||
         request.resource.data.favoritesCount == resource.data.get('favoritesCount', 0) - 1)
      ) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) &&
        request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
      ) || (
        // Decrement only alongside an actual comment delete, which is
        // already admin-only (see productComments' own delete rule) --
        // matched here rather than loosened to any signed-in user.
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) &&
        request.resource.data.commentsCount == resource.data.get('commentsCount', 0) - 1
      ) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharesCount']) &&
        request.resource.data.sharesCount == resource.data.get('sharesCount', 0) + 1
      ) || (
        // Live inventory decrement for a cash-on-delivery order's own buyer
        // (an admin already has unconditional update rights above, which
        // covers the electronic-payment release path -- this branch exists
        // only because a COD buyer is neither the product's owner nor an
        // admin). Every fact is cross-checked against the real, already-
        // validated escrowOrders doc -- its productId/buyerId/quantity were
        // themselves locked in at order-creation time against this exact
        // product -- so a buyer can only ever apply this once, for exactly
        // the quantity of a real completed COD order they placed against
        // this product. lastOrderApplied persists on the product as small
        // audit metadata and its "must differ from the stored value" check
        // blocks an immediate repeat click (not airtight against a
        // contrived alternating pattern, but consistent with this
        // project's already-stated reasonable-not-cryptographic bar for
        // every other self-attested flow in this file).
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt', 'lastOrderApplied']) &&
        request.resource.data.quantity >= 0 &&
        request.resource.data.lastOrderApplied is string &&
        resource.data.get('lastOrderApplied', null) != request.resource.data.lastOrderApplied &&
        get(/databases/$(database)/documents/escrowOrders/$(request.resource.data.lastOrderApplied)).data.buyerId == request.auth.uid &&
        get(/databases/$(database)/documents/escrowOrders/$(request.resource.data.lastOrderApplied)).data.productId == productId &&
        get(/databases/$(database)/documents/escrowOrders/$(request.resource.data.lastOrderApplied)).data.noProofPayment == true &&
        get(/databases/$(database)/documents/escrowOrders/$(request.resource.data.lastOrderApplied)).data.status == 'delivery_confirmed' &&
        request.resource.data.quantity == resource.data.quantity - get(/databases/$(database)/documents/escrowOrders/$(request.resource.data.lastOrderApplied)).data.quantity
      );

      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /sourcingRequests/{requestId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /chats/{chatId} {
      allow read: if isParticipant(resource.data) || isAdmin();
      // Participants may only bump the last-message preview when sending a
      // message, never rewrite participants, phones, or context.
      allow update: if isAdmin() || (
        isParticipant(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
      );
      allow create: if isActiveUser() && request.auth.uid in request.resource.data.participantIds;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data) || isAdmin();
        // Admins bypass participancy, per-chat lock, AND the sitewide
        // chat-disable switch entirely, so they can still post the
        // automated "conversation stopped" system warning or moderate
        // during a sitewide disable; regular participants are blocked from
        // posting any NEW message once an admin has locked this specific
        // chat, or while the owner has disabled chat sitewide (see
        // settings/chatDisabled -- adminChats, the separate admin team-chat
        // room, is entirely unaffected by this).
        allow create: if isAdmin() || (
          isActiveUser() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.get('locked', false) == false &&
          get(/databases/$(database)/documents/settings/chatDisabled).data.get('active', false) == false
        );
        allow update: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          resource.data.type == 'offer' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer']) &&
          (
            // Only ever a one-shot resolution of a still-pending offer -- the
            // UI never lets you respond to an already-resolved one, and
            // without this the rule would too, letting a scripted request
            // re-flip an already-accepted offer (which may already have a
            // live escrow order tracking real payment) back to declined, or
            // re-accept an already-declined one.
            (resource.data.senderId != request.auth.uid &&
             resource.data.offer.status == 'pending' &&
             request.resource.data.offer.status in ['accepted', 'declined', 'countered']) ||
            // The buyer may withdraw their own offer while it's still pending.
            (resource.data.senderId == request.auth.uid &&
             resource.data.offer.status == 'pending' &&
             request.resource.data.offer.status == 'cancelled')
          )
        );
        allow delete: if isAdmin();
      }
    }

    // Manually-attested "escrow" order tracker, one doc per accepted chat
    // offer (doc id == the offer message's own id). There is no payment
    // gateway or backend in this project, so nothing here holds or moves
    // real money -- every status is a self-reported attestation (buyer
    // claims payment sent, owner confirms real receipt against their own
    // settings/paymentInfo, buyer confirms delivery, either side can
    // dispute). What this DOES enforce for real: illegal state jumps are
    // rejected here, not just in the UI, and the trail is immutable (no
    // delete rule at all).
    match /escrowOrders/{orderId} {
      // Any admin used to be able to read every order here -- including
      // buyer/seller names, payment phone numbers, reference numbers, and
      // proof screenshots -- straight from the API, bypassing the
      // admin-payments.html page's own hasSection("payments") gate entirely.
      // Narrowed to match that gate for real: the order's own buyer/seller,
      // or an admin explicitly granted "payments" (owner always has it).
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId || isOwnerOrGranted('payments'));

      // Only a real participant of the actual accepted offer this order
      // references may create it, and buyerId/sellerId must be the chat's
      // real two participants (not an arbitrary third uid) -- checked
      // against the real chat/message docs, never trusted from the
      // client's own claim alone. The second branch covers the sitewide
      // chat-disabled path (see settings/chatDisabled): there's no chat or
      // offer message to check against at all there, so instead the buyer
      // is verified directly, the order id must be self-tagged 'direct_'
      // (so it can never collide with a real chatId/messageId pair from the
      // first branch), and the sellerId is checked against the product's
      // own real owner, not just trusted from the client's claim.
      // Both branches also cross-check quantity/pricePerUnit against the
      // real accepted offer (or the real product price) and require
      // totalAmount to actually equal quantity * pricePerUnit -- the normal
      // app UI always computes these correctly, but nothing used to stop a
      // scripted request from forging a mismatched (e.g. much lower)
      // totalAmount here, which every other part of the flow -- the
      // buyer/seller's own totals, the admin's payments queue, the seller's
      // payment-claimed notification -- would then trust at face value.
      allow create: if isSignedIn() &&
        request.resource.data.buyerId != request.resource.data.sellerId &&
        (request.auth.uid == request.resource.data.buyerId || request.auth.uid == request.resource.data.sellerId) &&
        request.resource.data.status == 'awaiting_payment' &&
        request.resource.data.quantity > 0 &&
        request.resource.data.totalAmount == request.resource.data.quantity * request.resource.data.pricePerUnit &&
        (
          (
            request.resource.data.chatId != null &&
            get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participantIds
              .hasAll([request.resource.data.buyerId, request.resource.data.sellerId]) &&
            get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(orderId)).data.offer.status == 'accepted' &&
            get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(orderId)).data.offer.quantity == request.resource.data.quantity &&
            get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(orderId)).data.offer.pricePerUnit == request.resource.data.pricePerUnit
          )
          ||
          (
            request.resource.data.chatId == null &&
            orderId.matches('^direct_.*$') &&
            request.auth.uid == request.resource.data.buyerId &&
            get(/databases/$(database)/documents/settings/chatDisabled).data.get('active', false) == true &&
            get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.ownerId == request.resource.data.sellerId &&
            get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price == request.resource.data.pricePerUnit
          )
        );

      // Every branch below is a narrow, one-directional jump gated to one
      // specific role -- see js/pages/dashboard-chat.js and
      // js/pages/admin-payments.js for the matching UI. Deliberately
      // separates "the buyer/seller attest" from "the owner confirms real
      // money movement", per the vulnerabilities guide's principle of not
      // letting general admin access double as financial authority.
      allow update: if isSignedIn() && (
        // Requires real proof, not just a status flip -- the phone number
        // paid FROM, a reference number, and a screenshot of the transfer,
        // all non-empty -- so whoever reviews this (owner or a
        // "payments"-granted admin) has something concrete to check, not
        // just the buyer's bare word.
        (request.auth.uid == resource.data.buyerId &&
         resource.data.status == 'awaiting_payment' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentClaimedAt', 'paymentMethodChosen', 'paymentMethodId', 'paymentPhoneNumber', 'paymentReferenceNumber', 'paymentProofUrl']) &&
         request.resource.data.status == 'payment_claimed' &&
         request.resource.data.paymentPhoneNumber is string && request.resource.data.paymentPhoneNumber.size() > 0 &&
         request.resource.data.paymentReferenceNumber is string && request.resource.data.paymentReferenceNumber.size() > 0 &&
         request.resource.data.paymentProofUrl is string && request.resource.data.paymentProofUrl.size() > 0)
        ||
        // Cash-on-delivery (or any other method the admin flags
        // noProofRequired) -- no transfer to verify, so this skips
        // payment_claimed entirely and jumps straight to payment_confirmed.
        // The chosen method must actually exist in settings/paymentInfo and
        // be flagged noProofRequired -- a buyer can't just claim "cod" on a
        // method that requires real proof.
        (request.auth.uid == resource.data.buyerId &&
         resource.data.status == 'awaiting_payment' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentConfirmedAt', 'paymentMethodId', 'paymentMethodChosen', 'noProofPayment']) &&
         request.resource.data.status == 'payment_confirmed' &&
         request.resource.data.noProofPayment == true &&
         get(/databases/$(database)/documents/settings/paymentInfo).data.methods
           .exists(m, m.id == request.resource.data.paymentMethodId && m.noProofRequired == true))
        ||
        (request.auth.uid == resource.data.buyerId &&
         resource.data.status == 'payment_confirmed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryConfirmedAt']) &&
         request.resource.data.status == 'delivery_confirmed')
        ||
        ((request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId) &&
         resource.data.status != 'released' && resource.data.status != 'refunded' && resource.data.status != 'disputed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disputedAt', 'disputedBy', 'disputeNote']) &&
         request.resource.data.status == 'disputed' &&
         request.resource.data.disputedBy == request.auth.uid)
        ||
        (isOwnerOrGranted('payments') &&
         resource.data.status == 'payment_claimed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentConfirmedAt']) &&
         request.resource.data.status == 'payment_confirmed')
        ||
        (isOwnerOrGranted('payments') &&
         resource.data.status == 'delivery_confirmed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releasedAt']) &&
         request.resource.data.status == 'released')
        ||
        (isOwnerOrGranted('payments') &&
         resource.data.status == 'disputed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releasedAt']) &&
         request.resource.data.status == 'released')
        ||
        (isOwnerOrGranted('payments') &&
         resource.data.status == 'disputed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'refundedAt']) &&
         request.resource.data.status == 'refunded')
      );

      // Owner-only, strictly -- not delegable via isOwnerOrGranted. Exists
      // purely for the pre-launch "reset fake data" tool in Supreme Mode
      // (see js/supreme-mode.js's Danger Zone tab), never a normal
      // operation once real deals are flowing through the marketplace.
      allow delete: if isOwner();
    }

    // A farmer's withdrawable balance -- lazily created (no doc = 0 in the
    // app's own default-object handling), written only by a payments-
    // granted admin (directly, or via Escrow.release()/
    // WithdrawalRequests.markPaid() in js/firebase.js, which run as that
    // same admin). This doesn't try to enforce that a write's *delta*
    // matches a specific order/withdrawal amount -- Firestore rules can't
    // cleanly correlate two separate document writes without Cloud
    // Functions, and a payments-granted admin is already this project's
    // full financial trust boundary (see escrowOrders above). The
    // immutable walletTransactions ledger below is the audit trail.
    // Delete is owner-only, strictly -- not delegable via isOwnerOrGranted
    // -- and exists purely for the pre-launch "reset fake data" tool in
    // Supreme Mode (see js/supreme-mode.js's Danger Zone tab), never a
    // normal operation once real money is moving through the ledger.
    match /wallets/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwnerOrGranted('payments'));
      allow create, update: if isOwnerOrGranted('payments') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableBalance', 'updatedAt']) &&
        request.resource.data.availableBalance is number;
      allow delete: if isOwner();
    }

    // Append-only ledger entry per credit/debit -- never updatable by
    // anyone, so the audit trail can never be silently rewritten. Deletable
    // by the owner only, and only for the same pre-launch reset tool
    // described above -- once real transactions exist this is the one
    // escape hatch from an otherwise-permanent record, used deliberately
    // and rarely, not a general-purpose edit path.
    match /walletTransactions/{txId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isOwnerOrGranted('payments'));
      allow create: if isOwnerOrGranted('payments') &&
        request.resource.data.type in ['credit', 'debit'] &&
        request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update: if false;
      allow delete: if isOwner();
    }

    // A farmer's payout request -- self-created, capped against their own
    // current balance at creation time. Resolved by a payments-granted
    // admin (paid/rejected) or cancelled by the farmer themselves while
    // still pending -- same shape as every other self-attested request in
    // this file. Delete is owner-only, same reset-tool reasoning as above.
    match /withdrawalRequests/{reqId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isOwnerOrGranted('payments'));
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.amount <= get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.get('availableBalance', 0);
      allow update: if
        (request.auth.uid == resource.data.uid && resource.data.status == 'requested' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status == 'cancelled')
        ||
        (isOwnerOrGranted('payments') && resource.data.status == 'requested' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'adminNote']) &&
         request.resource.data.status in ['paid', 'rejected']);
      allow delete: if isOwner();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isActiveUser() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participantIds &&
        request.resource.data.toUid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participantIds;
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() &&
        (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /favorites/{favId} {
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Follow graph -- doc id is "{followerId}_{followingId}", which makes
    // "already following?" and unfollow a direct doc lookup/delete instead
    // of a query. Read is public so follower/following counts (live
    // getCountFromServer queries, never a stored counter -- see
    // js/firebase.js's Follows export) work for any visitor, not just the
    // two people involved.
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followerId != request.resource.data.followingId &&
        followId == request.resource.data.followerId + '_' + request.resource.data.followingId;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    match /cartItems/{itemId} {
      allow read: if isSignedIn() &&
        (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /productComments/{commentId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.uid == request.auth.uid;
      // No self-edit feature exists in the app -- update was previously open
      // to the comment's own author too, which only ever mattered as a way
      // to rewrite uid/productId on an existing comment (e.g. reassigning
      // authorship to someone else, or moving it onto a different product),
      // never a real editing use case. Admin-only, matching reviews below.
      allow update: if isAdmin();
      allow delete: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Logged whenever a user's own client blocks their attempt to share a
    // phone number in chat/comments — visible only to admins for moderation.
    match /phoneAttempts/{attemptId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Near-real-time "who's doing what" feed (page views + a few key
    // actions) -- self-attested by every signed-in user's own client, same
    // shape/trust model as phoneAttempts above. Read/delete (for the 24h
    // retention sweep -- see js/firebase.js's Activity.purgeOld, no Cloud
    // Functions/cron exist in this project) is gated behind the delegable
    // "superAdmin" section, not blanket isAdmin(), since this is real-time
    // visibility into every user's browsing behavior across the whole site.
    match /userActivity/{eventId} {
      allow read, delete: if isOwnerOrGranted('superAdmin');
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Full admin-action audit trail (who did what, to what, when). Any admin
    // can write their own entries -- adminUid must be the real caller, same
    // anti-spoofing pattern as adminChats' senderId below, so the trail
    // stays complete even for admins who don't hold "superAdmin" -- but only
    // a "superAdmin" grant (or the owner) can read it, and only the owner
    // can edit/delete an entry, so the trail stays tamper-resistant even
    // from other Super Admins.
    match /adminAuditLog/{entryId} {
      allow read: if isOwnerOrGranted('superAdmin');
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // A single shared room for every admin — never exposed to regular users.
    match /adminChats/{messageId} {
      allow read: if isAdmin();
      // senderId must be the real caller -- without this, any admin could
      // post a message tagged with a DIFFERENT admin's uid, impersonating
      // them in the shared team room.
      allow create: if isAdmin() && request.resource.data.senderId == request.auth.uid;
      // Owner can always moderate; a message's own sender can also edit/
      // delete their own message any time -- an earlier version limited
      // this to a 15-minute window, but that just meant the delete button
      // stayed visible on older messages and silently failed when clicked,
      // reading as "deletion is broken" rather than a deliberate limit.
      // This is an internal admin-only room, not the public user chat, so
      // there's no real moderation reason to keep that window.
      allow update, delete: if isOwner() || (isAdmin() && resource.data.senderId == request.auth.uid);
    }

    // Written by any signed-in user into another user's own inbox (e.g. a
    // buyer notifying a farmer of a new offer) — informational only, no
    // control fields, so this "write into someone else's doc" trust level is
    // the same one already used for bumping products' view/offer/deal counts.
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'key', 'params', 'link', 'read', 'createdAt']) &&
        request.resource.data.read == false &&
        // "adminMessage" renders as an official admin notice ("رسالة من
        // إدارة ورقة شجر") -- without this, any signed-in user could forge
        // one against any other uid to impersonate the site admin.
        (request.resource.data.key != 'adminMessage' || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
