rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The one supreme account: immune to being demoted, banned, or removed
    // by any other admin, and always has full authority over admin docs.
    function isOwner() {
      return isSignedIn() && request.auth.token.email == 'sgyiath@gmail.com';
    }

    function isParticipant(chatData) {
      return isSignedIn() && request.auth.uid in chatData.participantIds;
    }

    // A suspended or banned user keeps read access but cannot create new
    // content (listings, requests, messages, reviews, reports).
    function isActiveUser() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    // Fields a normal user must never be able to set on themselves directly
    // (trust/role/moderation state — only admins or trusted server flows may change these).
    function userProtectedFields() {
      return ['status', 'suspendedUntil', 'ratingAverage', 'ratingCount', 'accountType', 'uid', 'createdAt', 'photoURL'];
    }

    // One-time bootstrap: only this exact account may grant itself admin.
    // Only the owner may create a new admin, revoke an existing admin doc,
    // or touch someone else's, or set allowedSections (granular per-section
    // permissions) — regular admins can only manage their own admin-mode
    // password / support opt-in, never demote/edit one another or grant
    // themselves more access.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner() ||
        (isSignedIn() && request.auth.uid == uid && request.auth.token.email == 'sgyiath@gmail.com');
      allow update: if isOwner() || (
        isAdmin() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminModeCode', 'acceptingSupport'])
      );
      allow delete: if isOwner();
    }

    // adminModeCode used to live on admins/{uid} itself, but that doc's read
    // rule is isSignedIn() (needed for the public support-admin picker and
    // isAdmin() checks) -- meaning any regular user's client could read
    // every admin's plaintext unlock code directly from the network
    // response. Split into its own doc with much narrower read access:
    // only that admin themselves, or the owner.
    match /adminSecrets/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwner());
      allow create: if isSignedIn() &&
        ((request.auth.uid == uid && request.auth.token.email == 'sgyiath@gmail.com') || isAdmin());
      allow update: if isOwner() || (isAdmin() && request.auth.uid == uid);
      allow delete: if isOwner() || (isAdmin() && request.auth.uid == uid);
    }

    match /users/{uid} {
      // Full profile documents hold phone/email — never expose them broadly.
      // Only the owner of the doc or an admin may read it; every legitimate
      // read site in the app (own-profile subscription, Admin.listAllUsers())
      // already fits this. Anything else (product owner name, chat participant
      // name, etc.) is denormalized onto its own document, not live-read here.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isOwner() ||
        (
          // Only the owner account may ever set photoURL -- an admin
          // moderating another user's doc still can't touch it here.
          isAdmin() && resource.data.email != 'sgyiath@gmail.com' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL'])
        ) || (
        isSignedIn() && request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(userProtectedFields())
      ) || (
        // Client-driven phone-violation enforcement, with no backend/cron to
        // run it server-side: a user may only ever flip their OWN status in
        // exactly two narrow directions — self-suspend for <=25h as the 3rd-
        // strike penalty, or self-reactivate once that window has genuinely
        // passed (request.time is server-evaluated, so this can't be spoofed
        // early). A `banned` account can never touch its own status here.
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'suspendedUntil']) &&
        (
          (resource.data.status == 'active' && request.resource.data.status == 'suspended' &&
           request.resource.data.suspendedUntil is timestamp &&
           request.resource.data.suspendedUntil > request.time &&
           request.resource.data.suspendedUntil <= request.time + duration.value(25, 'h'))
          ||
          (resource.data.status == 'suspended' && resource.data.suspendedUntil != null &&
           request.time > resource.data.suspendedUntil &&
           request.resource.data.status == 'active' && request.resource.data.suspendedUntil == null)
        )
      );
      allow delete: if isOwner() ||
        (isAdmin() && resource.data.email != 'sgyiath@gmail.com');
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      // paymentInfo holds the owner's own bank/wallet receiving details --
      // excluded from the public read here (unlike every other settings
      // doc) and given its own owner-only rule below.
      allow read: if docId != 'paymentInfo';
      // killSwitch and paymentInfo are excluded here and given their own
      // owner-only rules below -- Firestore ORs every matching block
      // together, so without this exclusion a regular admin would still be
      // able to write through this generic rule regardless of the narrower
      // ones.
      allow write: if isAdmin() && docId != 'killSwitch' && docId != 'paymentInfo';
    }

    // Emergency kill switch: owner-only, on purpose -- this is a
    // whole-site lock, not a normal admin setting. Read stays public
    // because every page (including logged-out visitors) must be able to
    // check it to know whether to render the lock screen.
    match /settings/killSwitch {
      allow read: if true;
      allow write: if isOwner();
    }

    // Owner's own payment-receiving details (Vodafone Cash / InstaPay / bank
    // account) for the manual-payment flow -- there's no live payment
    // gateway in this project, so buyers are told where to send money
    // manually and the owner confirms receipt themselves. Owner-only on
    // both read and write since this is personal financial info, not a
    // general admin setting other admins should ever see.
    match /settings/paymentInfo {
      allow read, write: if isOwner();
    }

    // Real homepage stat counters (registered farmers, completed deals) --
    // bumped by ordinary signed-in users at the moment those events happen
    // (registration, offer acceptance), not just admins. Same narrow
    // "bump by exactly 1" shape already used for products' view/offer/deal
    // counters; the isAdmin() branch above still covers full admin access.
    match /settings/publicStats {
      allow read: if true;
      allow write: if isSignedIn() && (
        (resource == null &&
         request.resource.data.diff({}).affectedKeys().hasOnly(['registeredFarmers']) &&
         request.resource.data.registeredFarmers == 1)
        ||
        (resource != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredFarmers']) &&
         request.resource.data.registeredFarmers == resource.data.get('registeredFarmers', 0) + 1)
        ||
        (resource == null &&
         request.resource.data.diff({}).affectedKeys().hasOnly(['completedDeals']) &&
         request.resource.data.completedDeals == 1)
        ||
        (resource != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedDeals']) &&
         request.resource.data.completedDeals == resource.data.get('completedDeals', 0) + 1)
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.viewsCount == 0 &&
        request.resource.data.offersCount == 0 &&
        request.resource.data.dealsCount == 0;

      // Owner/admin may edit listing content but not directly rewrite the
      // trust/ranking counters (viewsCount, offersCount, dealsCount).
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.ownerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['viewsCount', 'offersCount', 'dealsCount', 'ownerId'])
      ) || (
        // Public view counter: anyone may bump it by exactly 1, nothing else.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']) &&
        request.resource.data.viewsCount == resource.data.viewsCount + 1
      ) || (
        // Deals counter: only a signed-in user may bump it by exactly 1.
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dealsCount']) &&
        request.resource.data.dealsCount == resource.data.dealsCount + 1
      ) || (
        // Offers counter: only a signed-in user may bump it by exactly 1.
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offersCount']) &&
        request.resource.data.offersCount == resource.data.offersCount + 1
      );

      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /sourcingRequests/{requestId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /chats/{chatId} {
      allow read: if isParticipant(resource.data) || isAdmin();
      // Participants may only bump the last-message preview when sending a
      // message, never rewrite participants, phones, or context.
      allow update: if isAdmin() || (
        isParticipant(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
      );
      allow create: if isActiveUser() && request.auth.uid in request.resource.data.participantIds;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data) || isAdmin();
        // Admins bypass participancy entirely so they can post the automated
        // "conversation stopped" system warning; regular participants are
        // blocked from posting any NEW message once an admin has locked the chat.
        allow create: if isAdmin() || (
          isActiveUser() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.get('locked', false) == false
        );
        allow update: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          resource.data.type == 'offer' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer']) &&
          (
            (resource.data.senderId != request.auth.uid &&
             request.resource.data.offer.status in ['accepted', 'declined', 'countered']) ||
            // The buyer may withdraw their own offer while it's still pending.
            (resource.data.senderId == request.auth.uid &&
             resource.data.offer.status == 'pending' &&
             request.resource.data.offer.status == 'cancelled')
          )
        );
        allow delete: if isAdmin();
      }
    }

    // Manually-attested "escrow" order tracker, one doc per accepted chat
    // offer (doc id == the offer message's own id). There is no payment
    // gateway or backend in this project, so nothing here holds or moves
    // real money -- every status is a self-reported attestation (buyer
    // claims payment sent, owner confirms real receipt against their own
    // settings/paymentInfo, buyer confirms delivery, either side can
    // dispute). What this DOES enforce for real: illegal state jumps are
    // rejected here, not just in the UI, and the trail is immutable (no
    // delete rule at all).
    match /escrowOrders/{orderId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId || isAdmin());

      // Only a real participant of the actual accepted offer this order
      // references may create it, and buyerId/sellerId must be the chat's
      // real two participants (not an arbitrary third uid) -- checked
      // against the real chat/message docs, never trusted from the
      // client's own claim alone.
      allow create: if isSignedIn() &&
        request.resource.data.buyerId != request.resource.data.sellerId &&
        (request.auth.uid == request.resource.data.buyerId || request.auth.uid == request.resource.data.sellerId) &&
        request.resource.data.status == 'awaiting_payment' &&
        get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participantIds
          .hasAll([request.resource.data.buyerId, request.resource.data.sellerId]) &&
        get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(orderId)).data.offer.status == 'accepted';

      // Every branch below is a narrow, one-directional jump gated to one
      // specific role -- see js/pages/dashboard-chat.js and
      // js/pages/admin-payments.js for the matching UI. Deliberately
      // separates "the buyer/seller attest" from "the owner confirms real
      // money movement", per the vulnerabilities guide's principle of not
      // letting general admin access double as financial authority.
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.buyerId &&
         resource.data.status == 'awaiting_payment' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentClaimedAt']) &&
         request.resource.data.status == 'payment_claimed')
        ||
        (request.auth.uid == resource.data.buyerId &&
         resource.data.status == 'payment_confirmed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryConfirmedAt']) &&
         request.resource.data.status == 'delivery_confirmed')
        ||
        ((request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId) &&
         resource.data.status != 'released' && resource.data.status != 'refunded' && resource.data.status != 'disputed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disputedAt', 'disputedBy', 'disputeNote']) &&
         request.resource.data.status == 'disputed' &&
         request.resource.data.disputedBy == request.auth.uid)
        ||
        (isOwner() &&
         resource.data.status == 'payment_claimed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentConfirmedAt']) &&
         request.resource.data.status == 'payment_confirmed')
        ||
        (isOwner() &&
         resource.data.status == 'delivery_confirmed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releasedAt']) &&
         request.resource.data.status == 'released')
        ||
        (isOwner() &&
         resource.data.status == 'disputed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releasedAt']) &&
         request.resource.data.status == 'released')
        ||
        (isOwner() &&
         resource.data.status == 'disputed' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'refundedAt']) &&
         request.resource.data.status == 'refunded')
      );
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isActiveUser() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participantIds &&
        request.resource.data.toUid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participantIds;
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() &&
        (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /favorites/{favId} {
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /cartItems/{itemId} {
      allow read: if isSignedIn() &&
        (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /productComments/{commentId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Logged whenever a user's own client blocks their attempt to share a
    // phone number in chat/comments — visible only to admins for moderation.
    match /phoneAttempts/{attemptId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // A single shared room for every admin — never exposed to regular users.
    match /adminChats/{messageId} {
      allow read, create: if isAdmin();
      // Owner can always moderate; a message's own sender can also edit/
      // delete their own message any time -- an earlier version limited
      // this to a 15-minute window, but that just meant the delete button
      // stayed visible on older messages and silently failed when clicked,
      // reading as "deletion is broken" rather than a deliberate limit.
      // This is an internal admin-only room, not the public user chat, so
      // there's no real moderation reason to keep that window.
      allow update, delete: if isOwner() || (isAdmin() && resource.data.senderId == request.auth.uid);
    }

    // Written by any signed-in user into another user's own inbox (e.g. a
    // buyer notifying a farmer of a new offer) — informational only, no
    // control fields, so this "write into someone else's doc" trust level is
    // the same one already used for bumping products' view/offer/deal counts.
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'key', 'params', 'link', 'read', 'createdAt']) &&
        request.resource.data.read == false &&
        // "adminMessage" renders as an official admin notice ("رسالة من
        // إدارة ورقة شجر") -- without this, any signed-in user could forge
        // one against any other uid to impersonate the site admin.
        (request.resource.data.key != 'adminMessage' || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
